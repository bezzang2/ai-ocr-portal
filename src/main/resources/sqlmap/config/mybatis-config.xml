        <typeAlias alias="ocuocBzwkaEntity" type="com.agilesoda.module.apply.entity.OcuocBzwkaEntity" />
        <typeAlias alias="ocuocBzwkfEntity" type="com.agilesoda.module.apply.entity.OcuocBzwkfEntity" />
