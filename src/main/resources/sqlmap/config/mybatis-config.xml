        <typeAlias alias="ocuocBzaafEntity" type="com.agilesoda.module.apply.entity.OcuocBzaafEntity" />
        <typeAlias alias="ocuocBzscnEntity" type="com.agilesoda.module.apply.entity.OcuocBzscnEntity" />

        <typeAlias alias="ocuocAprvlEntity" type="com.agilesoda.module.common.entity.OcuocAprvlEntity" />

        <typeAlias alias="boardEntity" type="com.agilesoda.sample.entity.BoardEntity" />
